NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Default single treasury: the account_factory-deployed reference treasury
# running the fixed contract code (smart-contracts docs/SECURITY_REVIEW_STRICT.md
# finding 29 -- transfer_from/approve_adapter instead of a raw SAC transfer,
# closing a hard Soroban reentrancy wall that otherwise blocks
# execute_scheduled_payment from ever moving funds). See
# docs/TESTNET_FACTORY_DEPLOYMENT.md §13.2 in the smart-contracts repo. The
# previous addresses here predated that fix and are stale.
NEXT_PUBLIC_SMART_ACCOUNT_ID=CD6GY4UUTNPW4TUV7LDL5SELN4BBHJG4KDDT3W6G23DY6XCGM75MULMQ
NEXT_PUBLIC_POLICY_ENGINE_ID=CCOP7NRMST5K6TL7FBDMX25LDEPW3DSFBOGBIKVFIDNAAZY7GBMVP3M4
NEXT_PUBLIC_INTENT_REGISTRY_ID=CAFIATSIZQSBILZJWVT4PVDXPVITJHLP6LPAVKDRHCA7I7XPZSLTRPUS
NEXT_PUBLIC_RECOVERY_MANAGER_ID=CCHC4YKVYS3CAZUOUYWYTEMQ6TZDW75WB2BGENUC2CDWDX5RH7NMKZWU
NEXT_PUBLIC_TRANSFER_ADAPTER_ID=CBRYGIR3ORDW5LE6J7AVPSKRNTMRUYHD6FVPHQMJGPQLQ5FQUZ2U6GFH
NEXT_PUBLIC_SPLIT_ADAPTER_ID=CBQA7UI7QN6RN4IZT7WPDHWTK2OO7J4FH2KMCVJGKMKVFGDURD63UQ7U
NEXT_PUBLIC_STA_ASSET_CONTRACT_ID=CCOUVA654JH2V6B7LNTKHJP5DF3QA553RS2IIWXSGPDFH2N3QILIVU5L
NEXT_PUBLIC_TEST_RECIPIENT=GAK3XILRBYBMBOCZMSLL2CLR6WPQLEIOC6ZCYYPTE4OIAX3PCFFO2YMU

# account_factory: lets a connected wallet deploy its own treasury (smart_account
# + 5 supporting contracts) in one call. See docs/TESTNET_FACTORY_DEPLOYMENT.md.
NEXT_PUBLIC_ACCOUNT_FACTORY_ID=CAQQTRRYNXIQGFVNCTMTBJDXW3PN7O44KPT7GWCCE4FRKTOHDBCWGUZO

# Public key of the relayer's executor identity (Keypair.fromSecret(RELAYER_EXECUTOR_SECRET).publicKey()).
# Passed as `executor` when deploying a new treasury through the dApp so the
# shared relayer below can service it. Not secret -- this is the address, not
# the key -- but keep it in sync with RELAYER_EXECUTOR_SECRET.
NEXT_PUBLIC_RELAYER_EXECUTOR_ADDRESS=

# Server-only relayer configuration. Never expose these with NEXT_PUBLIC_.
RELAYER_EXECUTOR_SECRET=
RELAYER_ADMIN_TOKEN=
# Base URL of this app *including* its /app base path (next.config.ts). Used by
# `pnpm relayer:run` to reach POST <RELAYER_APP_URL>/api/relayer/run.
RELAYER_APP_URL=http://localhost:3000/app

# Server-only. Neon Postgres, the persistent store behind the treasury
# registry and the relayer job queue. Both used to be JSON files on disk,
# which a serverless deployment cannot keep: its filesystem is read-only
# outside /tmp and is discarded between invocations.
DATABASE_URL=

# The schema is defined in src/lib/db/schema.ts and applied with
# `pnpm db:migrate`. `pnpm db:generate` writes a new migration after a schema
# change; `pnpm db:baseline` is the one-time step for a database that already
# had the tables before Drizzle existed.
